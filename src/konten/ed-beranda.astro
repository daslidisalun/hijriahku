      <tr><td>3</td><td>Rabiulawal</td><td>Musim semi pertama</td><td>Bulan kelahiran Nabi Muhammad menurut tradisi yang umum dicatat</td></tr>
      <tr><td>4</td><td>Rabiulakhir</td><td>Musim semi terakhir</td><td>Lanjutan masa semi dalam penamaan Arab klasik</td></tr>
      <tr><td>5</td><td>Jumadilawal</td><td>Kering atau beku pertama</td><td>Merujuk pada masa kering atau dingin dalam penamaan awal</td></tr>
      <tr><td>6</td><td>Jumadilakhir</td><td>Kering atau beku terakhir</td><td>Penutup masa yang dirujuk oleh nama Jumadi</td></tr>

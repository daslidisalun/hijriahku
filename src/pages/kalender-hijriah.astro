---
import Utama from '../layouts/Utama.astro';
import EdKalender from '../konten/ed-kalender.astro';
---
<Utama
  title="Kalender Hijriah Interaktif — HijriahKu"
  description="Kalender bulan Hijriah lengkap: setiap tanggal Hijriah ditampilkan bersama padanan tanggal Masehi-nya, dengan navigasi antarbulan dan daftar bulan setahun."
>
  <div class="bungkus">
    <section class="bagian tengah">
      <p class="label-kecil">Perkakas</p>
      <h1>Kalender Hijriah</h1>
      <p class="sempit">
        Angka besar di setiap sel adalah tanggal Hijriah; angka kecil di bawahnya
        adalah tanggal Masehi padanannya. Gunakan tombol untuk berpindah bulan.
      </p>
    </section>

    <section class="kartu">
      <div class="kal-nav">
        <button type="button" id="kal-sebelum">← Bulan lalu</button>
        <span class="judul-bulan" id="kal-judul">Memuat…</span>
        <button type="button" id="kal-berikut">Bulan depan →</button>
      </div>
      <table class="tabel-kal" aria-label="Kalender bulan Hijriah">
        <thead>
          <tr><th>Min</th><th>Sen</th><th>Sel</th><th>Rab</th><th>Kam</th><th>Jum</th><th>Sab</th></tr>
        </thead>
        <tbody id="kal-isi"></tbody>
      </table>
      <p class="catatan-metode">
        Panjang setiap bulan (29 atau 30 hari) mengikuti hisab Umm al-Qura.
        Tanggal resmi bulan-bulan ibadah di Indonesia ditetapkan lewat sidang
        isbat Kementerian Agama dan dapat berbeda satu hari.
      </p>
    </section>

    <section class="bagian">
      <h2 id="judul-tahun">Dua Belas Bulan Tahun Ini</h2>
      <ul class="daftar-bulan" id="daftar-tahun"></ul>
    </section>

    <EdKalender />
  </div>

  <script>
    import { gKeH, hKeG, panjangBulanH, formatG, BULAN_HIJRIAH, BULAN_MASEHI, hariIniLokal, keNomorHari } from '../lib/hijri.js';

    const ini = hariIniLokal();
    const hIni = gKeH(ini);
    let tampil = { m: hIni.m, y: hIni.y };

    function gambarBulan() {
      const { m, y } = tampil;
      document.getElementById('kal-judul').textContent = `${BULAN_HIJRIAH[m - 1].nama} ${y} H`;
      const awal = hKeG({ d: 1, m, y });
      const panjang = panjangBulanH(m, y);
      // kolom awal: 0 = Minggu
      const geser = new Date(keNomorHari(awal) * 86400000).getUTCDay();
      const tbody = document.getElementById('kal-isi');
      tbody.innerHTML = '';
      let tr = document.createElement('tr');
      for (let i = 0; i < geser; i++) {
        const td = document.createElement('td');
        td.className = 'kosong';
        tr.appendChild(td);
      }
      for (let d = 1; d <= panjang; d++) {
        if ((geser + d - 1) % 7 === 0 && d > 1) { tbody.appendChild(tr); tr = document.createElement('tr'); }
        const g = hKeG({ d, m, y });
        const td = document.createElement('td');
        if (g.y === ini.y && g.m === ini.m && g.d === ini.d) td.className = 'hari-ini';
        const sh = document.createElement('span'); sh.className = 'dh'; sh.textContent = d;
        const sg = document.createElement('span'); sg.className = 'dg'; sg.textContent = `${g.d} ${BULAN_MASEHI[g.m - 1].slice(0, 3)}`;
        td.appendChild(sh); td.appendChild(sg);
        tr.appendChild(td);
      }
      const sisa = (geser + panjang) % 7;
      if (sisa !== 0) for (let i = sisa; i < 7; i++) { const td = document.createElement('td'); td.className = 'kosong'; tr.appendChild(td); }
      tbody.appendChild(tr);
      gambarDaftarTahun(y);
    }

    function gambarDaftarTahun(y) {
      document.getElementById('judul-tahun').textContent = `Dua Belas Bulan Tahun ${y} H`;
      const ul = document.getElementById('daftar-tahun');
      ul.innerHTML = '';
      for (let m = 1; m <= 12; m++) {
        const awal = hKeG({ d: 1, m, y });
        const akhir = hKeG({ d: panjangBulanH(m, y), m, y });
        const li = document.createElement('li');
        li.innerHTML = `<strong>${BULAN_HIJRIAH[m - 1].nama}</strong> — ${formatG(awal)} s.d. ${formatG(akhir)} (${panjangBulanH(m, y)} hari)`;
        ul.appendChild(li);
      }
    }

    document.getElementById('kal-sebelum')?.addEventListener('click', () => {
      tampil = tampil.m === 1 ? { m: 12, y: tampil.y - 1 } : { m: tampil.m - 1, y: tampil.y };
      gambarBulan();
    });
    document.getElementById('kal-berikut')?.addEventListener('click', () => {
      tampil = tampil.m === 12 ? { m: 1, y: tampil.y + 1 } : { m: tampil.m + 1, y: tampil.y };
      gambarBulan();
    });

    gambarBulan();
  </script>
</Utama>
